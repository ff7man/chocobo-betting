+const char* GetJockeyColorName(u8 jockey_type)
+{
+  static constexpr std::array<const char*, 4> names = {"Silver", "Gold", "Bronze", "Platinum"};
+  return jockey_type < names.size() ? names[jockey_type] : "Unknown";
+}
+
+const char* GetCourseName()
+{
+  // Class C's checkpoint always runs the short course, even with the Lua value 0.
+  if (s_patch.state_path.find("_2.sav") != std::string::npos || s_patch.course_value == 6)
+    return "Short";
+  return "Long";
+}
+
+std::string JsonEscape(std::string_view value)
+{
+  std::string result;
+  result.reserve(value.size());
+  for (const char ch : value)
+  {
+    if (ch == '"' || ch == '\\')
+      result.push_back('\\');
+    if (static_cast<unsigned char>(ch) >= 0x20)
+      result.push_back(ch);
+  }
+  return result;
+}
+
+std::string CsvEscape(std::string_view value)
+{
+  if (value.find_first_of(",\"\r\n") == std::string_view::npos)
+    return std::string(value);
+  std::string escaped = "\"";
+  for (const char ch : value)
+  {
+    if (ch == '"')
+      escaped.push_back('"');
+    escaped.push_back(ch);
+  }
+  escaped.push_back('"');
+  return escaped;
+}
+
+u16 ReadBigEndianHalfWord(u32 address, bool* ok)
+{
+  u16 value = 0;
+  *ok = CPU::SafeReadMemoryHalfWord(address, &value);
+  return *ok ? static_cast<u16>((value >> 8) | (value << 8)) : 0;
+}
+
+void AppendDataCsv(const std::array<RacerData, RACER_COUNT>& racers)
+{
+  if (!s_csv_output.is_open())
+  {
+    const std::filesystem::path path(s_patch.export_path);
+    std::error_code ec;
+    const bool needs_header = !std::filesystem::exists(path, ec) ||
+                              std::filesystem::file_size(path, ec) == 0;
+    s_csv_output.open(path, std::ios::out | std::ios::app);
+    if (!s_csv_output)
+    {
+      ERROR_LOG("Could not append generated data to '{}'.", s_patch.export_path);
+      return;
+    }
+    if (needs_header)
+      s_csv_output << "raceid,ts,rs2,rs1,acc,coop,intel,stamina1,stamina2,sprinting,course,jockey,winorder,pos,name,rank,frame,random\n";
+  }
+
+  for (const RacerData& racer : racers)
+  {
+    bool course_ok = false;
+    const u16 course = ReadBigEndianHalfWord(CHOCOBO_RACER_BASE +
+      static_cast<u32>(&racer - racers.data()) * CHOCOBO_RACER_STRIDE - 148, &course_ok);
+    s_csv_output << s_patch.races_completed - 1 << ','
+           << (racer.speed_ok ? fmt::format("{}", racer.top_speed) : "0") << ','
+           << (racer.rs2_ok ? fmt::format("{}", racer.rs2) : "0") << ','
+           << (racer.rs1_ok ? fmt::format("{}", racer.rs1) : "0") << ','
+           << (racer.acceleration_ok ? fmt::format("{:X}", racer.acceleration) : "0") << ','
+           << (racer.cooperation_ok ? fmt::format("{:X}", racer.cooperation) : "0") << ','
+           << (racer.intelligence_ok ? fmt::format("{:X}", racer.intelligence) : "0") << ','
+           << (racer.stamina_ok ? fmt::format("{}", racer.stamina) : "0") << ','
+           << (racer.stamina2_ok ? fmt::format("{}", racer.stamina2) : "0") << ','
+           << (racer.sprint_ok ? fmt::format("{:X}", racer.sprint) : "0") << ','
+           << (course_ok ? fmt::format("{:X}", course) : "0") << ','
+           << (racer.jockey_ok ? fmt::format("{:X}", racer.jockey) : "0") << ','
+           << (racer.finish_order_ok ? fmt::format("{:X}", racer.finish_order) : "0") << ','
+           << (racer.position_ok ? fmt::format("{:X}", racer.position) : "0") << ','
+           << CsvEscape(racer.name) << ',' << s_patch.data_rank << ',' << s_patch.target_frame << ','
+           << s_patch.course_value << '\n';
+  }
+}
