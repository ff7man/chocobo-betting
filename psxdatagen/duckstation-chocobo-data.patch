+void PrintDataProgress(bool force = false)
+{
+  if (!s_patch.data_generation)
+    return;
+
+  using Clock = std::chrono::steady_clock;
+  const Clock::time_point now = Clock::now();
+  if (!force && now - s_patch.data_last_progress_at < std::chrono::seconds(10))
+    return;
+
+  const u64 complete = s_patch.races_completed - s_patch.data_first_race_id;
+  const u64 races_per_frame = s_patch.data_both_courses && !s_patch.data_class_c ? 2 : 1;
+  u64 total = (static_cast<u64>(s_patch.data_end_frame) - s_patch.data_start_frame + 1) * races_per_frame;
+  if (s_patch.data_both_courses && !s_patch.data_class_c && s_patch.data_start_course_value == 6)
+    total--;
+  const double elapsed_seconds = std::chrono::duration<double>(now - s_patch.data_started_at).count();
+  const double rate = elapsed_seconds > 0.0 ? static_cast<double>(complete) / elapsed_seconds : 0.0;
+  const u64 remaining_seconds = rate > 0.0 ? static_cast<u64>((total - std::min<u64>(complete, total)) / rate) : 0;
+  const u64 days = remaining_seconds / 86400;
+  const u64 hours = (remaining_seconds / 3600) % 24;
+  const u64 minutes = (remaining_seconds / 60) % 60;
+  const u64 seconds = remaining_seconds % 60;
+
+  if (rate > 0.0)
+  {
+    std::printf("Progress: %llu complete / %llu total | %.2f races/s | ETA %llud %02llu:%02llu:%02llu\n",
+                static_cast<unsigned long long>(complete), static_cast<unsigned long long>(total), rate,
+                static_cast<unsigned long long>(days), static_cast<unsigned long long>(hours),
+                static_cast<unsigned long long>(minutes), static_cast<unsigned long long>(seconds));
+  }
+  else
+  {
+    std::printf("Progress: %llu complete / %llu total | %.2f races/s | ETA calculating\n",
+                static_cast<unsigned long long>(complete), static_cast<unsigned long long>(total), rate);
+  }
+  std::fflush(stdout);
+  if (s_csv_output.is_open())
+    s_csv_output.flush();
+  s_patch.data_last_progress_at = now;
+}
+
+void SetControllerButtons(u32 bits)
+{
+  Controller* controller = System::GetController(0);
+  if (!controller)
+    return;
+
+  for (u32 button = 0; button < static_cast<u32>(DigitalController::Button::Count); button++)
+  {
+    const bool pressed = (bits & (u32(1) << button)) != 0;
+    controller->SetBindState(button, pressed ? 1.0f : 0.0f);
+  }
+}
+
+bool WriteCourseLengthValue(u32 width, u32 value)
+{
+  switch (width)
+  {
+    case 0:
+      return true;
+    case 1:
+      return CPU::SafeWriteMemoryByte(COURSE_LENGTH_ADDRESS, static_cast<u8>(value));
+    case 2:
+      return CPU::SafeWriteMemoryHalfWord(COURSE_LENGTH_ADDRESS, static_cast<u16>(value));
+    case 4:
+      return CPU::SafeWriteMemoryWord(COURSE_LENGTH_ADDRESS, value);
+    default:
+      return false;
+  }
+}
+
+bool ReadCourseLengthWord(u32* value)
+{
+  return CPU::SafeReadMemoryWord(COURSE_LENGTH_ADDRESS, value);
+}
+
+void FinishWithError(const std::string& message)
+{
+  ERROR_LOG("Chocobo memory patch: {}", message);
+  SetControllerButtons(0);
+  if (s_patch.restore_fast_forward)
+  {
+    System::SetFastForwardEnabled(false);
+    s_patch.restore_fast_forward = false;
+  }
+  s_patch.stage = Stage::Finished;
+  if (System::IsRunning())
+    System::PauseSystem(true);
+}
