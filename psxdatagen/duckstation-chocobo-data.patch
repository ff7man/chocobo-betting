+  u32 race_start_frames = 0;
+  u32 race_frames = 0;
+  u32 course_value = 0;
+  bool auto_run = false;
+  bool run_both_courses = false;
+  bool exit_after_capture = false;
+  bool export_enabled = false;
+  bool data_generation = false;
+  bool data_both_courses = false;
+  bool data_class_c = false;
+  bool restore_fast_forward = false;
+  u32 races_completed = 0;
+  u32 data_start_frame = 0;
+  u32 data_end_frame = 0;
+  u32 data_current_frame = 0;
+  u32 data_first_race_id = 0;
